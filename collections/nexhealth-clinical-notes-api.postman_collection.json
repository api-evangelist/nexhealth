{
  "item": [
    {
      "id": "e20bbf07-48f3-4b28-b61a-0d5e2e19c5ec",
      "name": "Clinical Notes",
      "description": {
        "content": "Clinical notes are the official documentation of a patient's clinical encounter or care interaction",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a12d231b-0f6d-4879-973e-727db2abd51d",
          "name": "View clinical notes",
          "request": {
            "name": "View clinical notes",
            "description": {
              "content": "This endpoint returns the clinical notes for the specified location. At least one of the patient_id, procedure_id, entered_before, entered_after, or updated_since filters must be provided. Results are cursor-paginated.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "clinical_notes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "subdomain",
                  "value": "<string>",
                  "description": "(Required) Used to scope the request to the specified institution"
                },
                {
                  "disabled": false,
                  "key": "location_id",
                  "value": "<integer>",
                  "description": "(Required) Used to scope the request to the specified location"
                },
                {
                  "disabled": false,
                  "key": "patient_id",
                  "value": "<integer>",
                  "description": "Filter by the id of the associated patient"
                },
                {
                  "disabled": false,
                  "key": "procedure_id",
                  "value": "<integer>",
                  "description": "Filter by procedure, only return clinical notes that are associated with the procedure ID. This association only exists in certain EHRs and for certain types of notes"
                },
                {
                  "disabled": false,
                  "key": "entered_before",
                  "value": "<dateTime>",
                  "description": "Only return clinical notes that were created on or before the provided datetime"
                },
                {
                  "disabled": false,
                  "key": "entered_after",
                  "value": "<dateTime>",
                  "description": "Only return clinical notes that were created on or after the provided datetime"
                },
                {
                  "disabled": false,
                  "key": "updated_since",
                  "value": "<dateTime>",
                  "description": "Only return clinical notes updated after the specified time (UTC)"
                },
                {
                  "disabled": false,
                  "key": "start_cursor",
                  "value": "<string>",
                  "description": "First item of the current page. Starts empty"
                },
                {
                  "disabled": false,
                  "key": "end_cursor",
                  "value": "<string>",
                  "description": "Last item of the current page. Starts empty"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "5",
                  "description": "Number of results to return per page. Maximum allowed amount is 1000."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The NexHealth API version",
                "key": "Nex-Api-Version",
                "value": "v3.0.0"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
