{
  "item": [
    {
      "id": "e69ce9cb-0aae-4f77-ba51-24f3d0864e96",
      "name": "Available Slots",
      "description": {
        "content": "Available start date/times for an appointment",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "50c29275-a656-42b1-9f64-97762728eda4",
          "name": "View available slots",
          "request": {
            "name": "View available slots",
            "description": {
              "content": "This endpoint returns the bookable slots for the requested locations over the given date range, computed from provider availabilities and existing appointments. At least one of pids or appointment_type_id must be provided.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "available_slots"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "subdomain",
                  "value": "<string>",
                  "description": "(Required) Used to scope the request to the specified institution"
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "(Required) Date string you want results to start at, format YYYY-MM-DD"
                },
                {
                  "disabled": false,
                  "key": "days",
                  "value": "<integer>",
                  "description": "(Required) Number of days to include, counting the start date. For best performance, this value should not exceed 14 days."
                },
                {
                  "disabled": false,
                  "key": "appointment_type_id",
                  "value": "<integer>",
                  "description": "Specify an appointment type to filter returned slots and set slot_length to appointment_type.minutes"
                },
                {
                  "disabled": false,
                  "key": "working_hour_label_id",
                  "value": "<integer>",
                  "description": "Filter by specific working hour label"
                },
                {
                  "disabled": false,
                  "key": "working_hour_source",
                  "value": "<string>",
                  "description": "Filter by source of working hours"
                },
                {
                  "disabled": false,
                  "key": "slot_length",
                  "value": "<integer>",
                  "description": "Manually specify slot length in minutes. Defaults to 15 minutes"
                },
                {
                  "disabled": false,
                  "key": "slot_interval",
                  "value": "<integer>",
                  "description": "Manually specify the time in minutes between returned slot start times when a contiguous opening exists longer than the slot_length"
                },
                {
                  "disabled": false,
                  "key": "overlapping_operatory_slots",
                  "value": "false",
                  "description": "Return all available slots for operatories at a given time instead of returning only the first found. Default is false"
                },
                {
                  "disabled": false,
                  "key": "appointments_per_timeslot",
                  "value": "1",
                  "description": "Number of appointments (default:1, max:5) that can be booked in a single slot. Only supported for eClinicalWorks and NextGen."
                },
                {
                  "disabled": false,
                  "key": "lids[]",
                  "value": "<integer>",
                  "description": "(Required) Array of Location Ids"
                },
                {
                  "disabled": false,
                  "key": "lids[]",
                  "value": "<integer>",
                  "description": "(Required) Array of Location Ids"
                },
                {
                  "disabled": false,
                  "key": "pids[]",
                  "value": "<integer>",
                  "description": "Array of Provider Ids"
                },
                {
                  "disabled": false,
                  "key": "pids[]",
                  "value": "<integer>",
                  "description": "Array of Provider Ids"
                },
                {
                  "disabled": false,
                  "key": "operatory_ids[]",
                  "value": "<integer>",
                  "description": "Specify this if booking is mapped to operatory in this location"
                },
                {
                  "disabled": false,
                  "key": "operatory_ids[]",
                  "value": "<integer>",
                  "description": "Specify this if booking is mapped to operatory in this location"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The NexHealth API version",
                "key": "Nex-Api-Version",
                "value": "v3.0.0"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
