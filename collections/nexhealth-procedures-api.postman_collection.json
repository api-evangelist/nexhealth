        {
          "id": "f9d8e717-761b-4a42-a673-2a0eeca31051",
          "name": "View procedures",
          "request": {
            "name": "View procedures",
            "description": {
              "content": "This endpoint returns a list of procedures.\n You can filter by provider_id, patient_id, appointment_id, started_after, started_before, ended_after, ended_before or\n updated_since. You must provide at least one filter. You may additionally narrow any of these filters by location_id,\n but location_id alone does not satisfy the at-least-one-filter requirement.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "procedures"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "subdomain",
                  "value": "<string>",
                  "description": "(Required) Used to scope the request to the specified institution"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Optional comma-separated string of fields to sort on.\nInclude a leading dash for descending order.\n\nAvailable fields:\n  * updated_at\n  * -updated_at\n"
                },
                {
                  "disabled": false,
                  "key": "location_id",
                  "value": "<integer>",
                  "description": "Filter for specific location. Cannot be used as the only filter — combine it with at least one other filter"
                },
                {
                  "disabled": false,
                  "key": "provider_id",
                  "value": "<integer>",
                  "description": "Filter for specific provider"
                },
                {
                  "disabled": false,
                  "key": "patient_id",
                  "value": "<integer>",
                  "description": "Filter for specific patient"
                },
                {
                  "disabled": false,
                  "key": "appointment_id",
                  "value": "<integer>",
                  "description": "Filter for specific appointment"
                },
                {
                  "disabled": false,
                  "key": "updated_since",
                  "value": "<dateTime>",
                  "description": "Procedures updated at or after the specified time (UTC). The comparison is inclusive, so a record whose updated_at exactly equals the given value is returned"
                },
                {
                  "disabled": false,
                  "key": "started_after",
                  "value": "<date>",
                  "description": "Filter for procedures with start_date after a specific date (including the date)"
                },
                {
                  "disabled": false,
                  "key": "started_before",
                  "value": "<date>",
                  "description": "Filter for procedures with start_date before a specific date (including the date)"
                },
                {
                  "disabled": false,
                  "key": "ended_after",
                  "value": "<date>",
                  "description": "Filter for procedures with end_date after a specific date (including the date)"
                },
                {
                  "disabled": false,
                  "key": "ended_before",
                  "value": "<date>",
                  "description": "Filter for procedures with end_date before a specific date (including the date)"
                },
                {
                  "disabled": false,
                  "key": "start_cursor",
                  "value": "<string>",
                  "description": "First item of the current page. Starts empty"
                },
                {
                  "disabled": false,
                  "key": "end_cursor",
                  "value": "<string>",
                  "description": "Last item of the current page. Starts empty"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "5",
                  "description": "Number of results to return per page. Maximum allowed amount is 1000."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The NexHealth API version",
                "key": "Nex-Api-Version",
                "value": "v3.0.0"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
