          "name": "View patient recalls",
          "request": {
            "name": "View patient recalls",
            "description": {
              "content": "This endpoint returns the patient recalls for the specified location, narrowed down by the optional filters configured.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "patient_recalls"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "subdomain",
                  "value": "<string>",
                  "description": "(Required) Used to scope the request to the specified institution"
                },
                {
                  "disabled": false,
                  "key": "start_cursor",
                  "value": "<string>",
                  "description": "First item of the current page. Starts empty"
                },
                {
                  "disabled": false,
                  "key": "end_cursor",
                  "value": "<string>",
                  "description": "Last item of the current page. Starts empty"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "5",
                  "description": "Number of results to return per page. Maximum allowed amount is 1000."
                },
                {
                  "disabled": false,
                  "key": "location_id",
                  "value": "<integer>",
                  "description": "(Required) Used to scope the request to the specified location"
                },
                {
                  "disabled": false,
                  "key": "recall_id",
                  "value": "<integer>",
                  "description": "Filter by the id of the associated recall type"
                },
                {
                  "disabled": false,
                  "key": "patient_id",
                  "value": "<integer>",
                  "description": "Filter by the id of the associated patient"
                },
                {
                  "disabled": false,
                  "key": "foreign_id",
                  "value": "<string>",
                  "description": "Filter by the EHR id of the recall"
                },
                {
                  "disabled": false,
                  "key": "updated_since",
                  "value": "<dateTime>",
                  "description": "Return records updated since the specified date/time in ISO8601 format"
                },
                {
                  "disabled": false,
                  "key": "due_after",
                  "value": "<dateTime>",
                  "description": "Return recalls due on or after the specified date/time in ISO8601 format"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Optional comma-separated string of fields to sort on.\nInclude a leading dash for descending order.\n\nAvailable fields:\n  * date_due\n  * -date_due\n"
                }
              ],
              "variable": []
            },
