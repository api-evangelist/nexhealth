          "name": "Create onboarding",
          "request": {
            "name": "Create onboarding",
            "description": {
              "content": "Creates an onboarding link to set up NexHealth at a practice. Include institution_name to onboard a new institution, or subdomain to add locations to an existing institution. Send the returned url to practice staff; it expires 3 months after creation. Only production applications can create onboardings.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "onboardings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
