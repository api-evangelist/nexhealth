          "id": "602d6de4-adc1-40b3-8820-8f13bd12c11c",
          "name": "View claims",
          "request": {
            "name": "View claims",
            "description": {
              "content": "This endpoint returns a list of insurance claims for a location. You can filter by patient_id, guarantor_id, provider_id, updated_since or date_of_service, and must provide at least one of these filters. location_id is always required, but does not satisfy the at-least-one-filter requirement on its own. Soft-deleted claims are excluded unless include_deleted is true.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "claims"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "subdomain",
                  "value": "<string>",
                  "description": "(Required) Used to scope the request to the specified institution"
                },
                {
                  "disabled": false,
                  "key": "location_id",
                  "value": "<integer>",
                  "description": "(Required) Used to scope the request to the specified location"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Optional comma-separated string of fields to sort on.\nInclude a leading dash for descending order.\n\nAvailable fields:\n  * updated_at\n  * -updated_at\n"
                },
                {
                  "disabled": false,
                  "key": "patient_id",
                  "value": "<integer>",
                  "description": "The ID of the patient associated with the claim"
                },
                {
                  "disabled": false,
                  "key": "guarantor_id",
                  "value": "<integer>",
                  "description": "The ID of the guarantor associated with the claim"
                },
                {
                  "disabled": false,
                  "key": "provider_id",
                  "value": "<integer>",
                  "description": "The ID of the provider associated with the claim"
                },
                {
                  "disabled": false,
                  "key": "updated_since",
                  "value": "<dateTime>",
                  "description": "Claims updated at or after the specified time (UTC). The comparison is inclusive, so a record whose updated_at exactly equals the given value is returned"
                },
                {
                  "disabled": false,
                  "key": "date_of_service",
                  "value": "<date>",
                  "description": "Claims whose date of service exactly matches the specified date"
                },
                {
                  "disabled": false,
                  "key": "include_deleted",
                  "value": "false",
                  "description": "Include soft-deleted claims in the results"
                },
                {
                  "disabled": false,
                  "key": "start_cursor",
                  "value": "<string>",
                  "description": "First item of the current page. Starts empty"
                },
                {
                  "disabled": false,
                  "key": "end_cursor",
                  "value": "<string>",
                  "description": "Last item of the current page. Starts empty"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "5",
                  "description": "Number of results to return per page. Maximum allowed amount is 1000."
                }
              ],
              "variable": []
            },
