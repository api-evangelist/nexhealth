{
  "opencollection": "1.0.0",
  "info": {
    "name": "NexHealth Adjustment Types Webhook Subscriptions API",
    "version": "v20240412"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
